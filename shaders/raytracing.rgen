// shaders/raytracing.rgen
// Primary-ray generator. Samples the TLAS through traceRayEXT and writes a
// shaded RGBA8 result into a storage image at set=0,binding=0. A single
// bounce (primary + a single shadow query in the closest-hit shader) keeps
// recursion depth at 1.

#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba8) uniform image2D outImage;
layout(set = 0, binding = 2) uniform CameraUBO {
    mat4 view_inverse;
    mat4 proj_inverse;
    vec4 light_dir;
    vec4 light_color;
} cam;

layout(location = 0) rayPayloadEXT vec3 hitValue;

void main() {
    const ivec2 px  = ivec2(gl_LaunchIDEXT.xy);
    const vec2  uv  = (vec2(px) + vec2(0.5)) / vec2(gl_LaunchSizeEXT.xy);
    const vec2  ndc = uv * 2.0 - 1.0;

    vec4 origin    = cam.view_inverse * vec4(0, 0, 0, 1);
    vec4 target    = cam.proj_inverse * vec4(ndc.x, ndc.y, 1, 1);
    vec4 direction = cam.view_inverse * vec4(normalize(target.xyz), 0);

    hitValue = vec3(0.0);
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF,
                0, 0, 0,
                origin.xyz, 0.001,
                direction.xyz, 10000.0,
                0);

    imageStore(outImage, px, vec4(hitValue, 1.0));
}
